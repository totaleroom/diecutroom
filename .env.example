# DieCut.Room Environment Configuration Template
# Copy to .env on your VPS (`cp .env.example .env && chmod 600 .env`)

# Pinned Docker image release tag (used by docker-compose.yml for easy rollback)
IMAGE_TAG=1.5.0

# Host bind port for Docker Compose (change to e.g. 3001 if port 3000 is used by another VPS app)
HOST_PORT=3000

# Server Runtime Port (Docker keeps 3000 inside container; in PM2 mode change PORT directly if 3000 is occupied)
PORT=3000
NODE_ENV=development

# SQLite Persistent Database File Path
# - Docker Compose: /app/data/diecut.db (mapped from ./data)
# - Debian Node/PM2: /opt/diecut-room/data/diecut.db (or ./data/diecut.db)
SQLITE_PATH="./data/diecut.db"

# HMAC Cookie Signing Secret (Generate strong 64-char hex string in production: openssl rand -hex 32)
SESSION_SECRET="replace-with-strong-random-64-char-secret"

# Seeded Initial Administrator Account (created once on first boot if no admin exists yet)
ADMIN_EMAIL="totale.room@gmail.com"
ADMIN_INITIAL_PASSWORD="ChangeThisAdminPassword!"

# Admin WhatsApp Verification Number (International format without '+'; baked in at build time)
VITE_WHATSAPP_ADMIN="6282125086328"

# Set to true when running behind Nginx / Cloudflare HTTPS reverse proxy
TRUST_PROXY=true
