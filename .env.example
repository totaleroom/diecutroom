# DieCut.Room Core Runtime Environment Configuration
# Copy to .env on your VPS (`cp .env.example .env && chmod 600 .env`)
# Note for Docker Compose on VPS: IMAGE_TAG (default 1.5.0) and HOST_PORT (default 3000)
# already have built-in fallbacks in docker-compose.yml and only need to be added to server .env if overridden.

# Server Runtime Port
PORT=3000
NODE_ENV=development

# SQLite Persistent Database File Path
SQLITE_PATH="./data/diecut.db"

# HMAC Cookie Signing Secret (Generate strong 64-char hex string in production: openssl rand -hex 32)
SESSION_SECRET="replace-with-strong-random-64-char-secret"

# Seeded Initial Administrator Account (created once on first boot if no admin exists yet)
ADMIN_EMAIL="totale.room@gmail.com"
ADMIN_INITIAL_PASSWORD="ChangeThisAdminPassword!"

# Optional emergency Admin Recovery Key fallback (also configurable & rotatable inside Admin Console)
ADMIN_RECOVERY_KEY="replace-with-optional-admin-recovery-key"

# Admin WhatsApp Verification Number (International format without '+'; baked in at build time)
VITE_WHATSAPP_ADMIN="6282125086328"

# Set to true when running behind Cloud Run / Nginx / Cloudflare HTTPS reverse proxy
TRUST_PROXY=true

# Container / Health Radar memory limit threshold in MB (matches docker-compose mem_limit: 256m)
# MEMORY_LIMIT_MB=256

# Optional SMTP configuration for Admin Email OTP recovery (can also be configured in Admin Console UI)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-sender@domain.com
# SMTP_PASS=your-smtp-app-password
# SMTP_FROM="DieCut.Room Security <your-sender@domain.com>"
